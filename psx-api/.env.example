# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://psx_user:psx_pass@localhost:5432/psx_dev
DATABASE_TEST_URL=postgresql+asyncpg://psx_user:psx_pass@localhost:5432/psx_test

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Auth ────────────────────────────────────────────────────────────────────
SECRET_KEY=                           # generate: openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Email (transactional) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@[YOUR_DOMAIN]
EMAIL_FROM_NAME=[BUSINESS_NAME]

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Object Storage (Cloudflare R2 or S3-compatible) ─────────────────────────
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=psx-raw-data

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development               # development | staging | production
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# ─── Payment gateways (Pakistan) ─────────────────────────────────────────────
# Leave creds blank for sandbox mode — the system returns a local stub URL
# so the checkout flow works end-to-end without merchant onboarding.

# Callback / return base URLs used to build webhook + post-redirect URLs.
PAYMENTS_BASE_URL=http://localhost:8000
PAYMENTS_RETURN_URL=http://localhost:3000/checkout/return

# JazzCash (HBL Pay) — HTTP POST + HMAC-SHA256
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENVIRONMENT=sandbox          # sandbox | live

# Easypaisa (Telenor Microfinance Bank) — Easypay
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENVIRONMENT=sandbox

# Meezan Bank IPG — redirect + SHA-256 hash
MEEZAN_MERCHANT_ID=
MEEZAN_SECRET_KEY=
MEEZAN_ENVIRONMENT=sandbox

# 1LINK PayFast (covers Allied / HBL / UBL / Alfalah / MCB / etc.)
PAYFAST_MERCHANT_ID=
PAYFAST_SECRET_KEY=
PAYFAST_ENVIRONMENT=sandbox

# SafePay — REST + signed webhooks
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=sandbox

# NayaPay — wallet REST + signed webhooks
NAYAPAY_API_KEY=
NAYAPAY_WEBHOOK_SECRET=
NAYAPAY_ENVIRONMENT=sandbox
