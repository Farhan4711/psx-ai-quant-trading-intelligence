{
  "name": "@psx/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types + API client helpers between psx-web and the FastAPI backend.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts",
    "./generated": "./src/generated.ts"
  },
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.4.3",
    "typescript": "5.7.2"
  }
}
