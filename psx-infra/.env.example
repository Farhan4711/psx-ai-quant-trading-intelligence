# psx-infra environment variables
# Copy to .env.staging or .env.prod and fill in values.
# NEVER commit the actual .env files.

# ─── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_REPO=Farhan4711/psx-ai-quant-trading-intelligence

# ─── Image tags (set by CI/CD on deploy) ─────────────────────────────────────
API_IMAGE_TAG=latest
INGEST_IMAGE_TAG=latest
INFERENCE_IMAGE_TAG=latest

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=psx_user
POSTGRES_PASSWORD=                    # generate: openssl rand -base64 32

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                       # generate: openssl rand -base64 32

# ─── Application secrets ─────────────────────────────────────────────────────
API_SECRET_KEY=                       # generate: openssl rand -hex 32

# ─── Domain ──────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
FRONTEND_INTERNAL_URL=http://localhost:3000

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN_API=
SENTRY_DSN_INGEST=
SENTRY_DSN_INFERENCE=

# ─── Object Storage (Cloudflare R2) ──────────────────────────────────────────
STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=psx-raw-data
